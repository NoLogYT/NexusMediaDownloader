# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
API_SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://nexus:password@localhost:5432/nexus_db

# Redis
REDIS_URL=redis://localhost:6379

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Optional: Sentry
SENTRY_DSN=
